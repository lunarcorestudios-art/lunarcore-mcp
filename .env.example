# Adapter selection. memory (default) is a working in-memory stub.
# clickup serves live Client Work data and requires CLICKUP_API_TOKEN and CLICKUP_TEAM_ID.
# google is still a typed placeholder and refuses to start.
LUNARCORE_ADAPTER=memory

# Identity returned by whoami / workspace_context on the memory adapter.
# The ClickUp adapter uses the token's ClickUp user and the team name instead.
LUNARCORE_WORKSPACE_NAME=Lunarcore Studios
LUNARCORE_ACTOR_NAME=Lunarcore Operator
LUNARCORE_ACTOR_EMAIL=operator@lunarcore.studio
LUNARCORE_ACTOR_ROLE=producer

# ClickUp personal API token (Settings → Apps). Sent as the raw Authorization header.
# Required when LUNARCORE_ADAPTER=clickup. Never commit a real token.
# CLICKUP_API_TOKEN=
# Workspace / team id. Lunarcore: 9016194264
# CLICKUP_TEAM_ID=9016194264
# Optional. Defaults to the space named "Client Work" (known id 90166903137).
# CLICKUP_SPACE_ID=90166903137

# Future Google adapter (Docs, Drive, Calendar). Not read by the memory or ClickUp adapters.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
