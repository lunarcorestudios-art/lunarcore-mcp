# Adapter selection. memory (default) is a working in-memory stub.
# clickup and google are typed placeholders and refuse to start until implemented.
LUNARCORE_ADAPTER=memory

# Identity returned by whoami / workspace_context.
LUNARCORE_WORKSPACE_NAME=Lunarcore Studios
LUNARCORE_ACTOR_NAME=Lunarcore Operator
LUNARCORE_ACTOR_EMAIL=operator@lunarcore.studio
LUNARCORE_ACTOR_ROLE=producer

# Future ClickUp adapter. Not read by the memory stub.
# CLICKUP_API_TOKEN=
# CLICKUP_TEAM_ID=

# Future Google adapter (Docs, Drive, Calendar). Not read by the memory stub.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
